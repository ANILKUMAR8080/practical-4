#include <iostream>
using namespace std;

int main()
{
    int n;
    long long factorial = 1;

    cout << "Enter a number: ";
    cin >> n;

    // Check for negative number
    if (n < 0)
    {
        cout << "Factorial is not defined for negative numbers.";
    }
    else
    {
        // For 0, this loop will not execute
        // and factorial remains 1.
        for (int i = 1; i <= n; i++)
        {
            factorial = factorial * i;
        }

        cout << "Factorial of " << n << " = " << factorial;
    }

    return 0;
}
